{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["scripts/store-shots/**"],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "classMembers": "off",
    "duplicates": "warn"
  },
  "workspaces": {
    "apps/web": {
      "ignoreDependencies": [
        "@tailwindcss/turbopack"
      ]
    },
    "apps/api": {
      "entry": ["src/main.ts", "scripts/*.ts"],
      "ignoreDependencies": [
        "@prisma/client"
      ]
    },
    "apps/mobile": {
      "entry": ["src/**/*.{ios,android}.{ts,tsx}"]
    }
  }
}
