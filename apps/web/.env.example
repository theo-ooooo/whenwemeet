# apps/web/.env.local — Next.js 프론트. `cp apps/web/.env.example apps/web/.env.local` 후 값 채움
# 브라우저는 API 를 직접 부르지 않고 Next route handler 가 프록시한다 (docs/설계/인증흐름.md, 결정기록 D-09)
# 운영(Vercel) 값과 환경별 설정은 docs/운영/배포.md "웹 (Vercel)" 표가 기준이다. 변수를 늘리면 그 표와 이 파일을 같이 고친다 (#204)

# 서버(route handler) 에서만 쓰는 API 주소. NEXT_PUBLIC_ 접두사를 붙이지 말 것 (브라우저 노출 금지)
# 로컬은 apps/api 의 PORT 와 맞추고, 운영은 배포된 API 의 공개 주소
API_URL=http://localhost:4000

# 1 이면 API 없이 메모리 목(src/mocks)으로 뜬다. 백엔드 없이 화면 확인할 때. Vercel Preview 만 1, Production 에는 절대 넣지 않음
API_MOCK=

# 웹 자신의 공개 주소. 메타데이터(og:url 등) 와 절대 링크 생성용. 공개 값이라 NEXT_PUBLIC_ 허용
# 운영은 Vercel 도메인 또는 연결한 커스텀 도메인
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (#186, D-115) API 의 INTERNAL_API_KEY 와 같은 값 (비밀). 웹이 API 를 부를 때 X-Internal-Key 와 사용자 IP 를 싣는다
# 로컬은 API 와 같이 비워 둬도 된다 (이메일 로그인은 운영에서만 이 키를 요구)
INTERNAL_API_KEY=

# (#245, D-119) 1 이면 로그인 화면에 "이메일로 계속하기". API 의 EMAIL_LOGIN_ENABLED 를 먼저 켠다. 목 모드는 0 이 아니면 켜짐
EMAIL_LOGIN_ENABLED=

# (#129) 1 이면 웹 로그인 화면에 애플 버튼. API 의 APPLE_* 를 넣고 확인한 뒤에 켠다
APPLE_LOGIN_ENABLED=

# 앱 딥링크 검증 파일. 비면 /.well-known/apple-app-site-association, /.well-known/assetlinks.json 이 404
# Apple Team ID (iOS 유니버설 링크)
APPLE_TEAM_ID=
# 앱 서명 인증서 SHA-256, 쉼표 구분 (Android 앱 링크)
ANDROID_CERT_SHA256=
# (#271, D-177) 1 이면 AASA 에 메일 로그인 링크 /auth/email 를 싣는다. iOS 1.1.1 이 퍼진 뒤에 켠다
EMAIL_APP_LINK_ENABLED=

# (#154, D-72) 스토어 출시 후에만. 1 = iOS, Android 둘 다, ios 또는 android = 그 OS 만 (쉼표로 둘 다). 비면 초대 화면에서 스토어로 보내지 않음
APP_STORE_LIVE=

# (#185) 오류 수집 Sentry (docs/운영/모니터링.md). 비우면 꺼진다. 로컬은 비워 둔다
# 브라우저용 (빌드 때 박힘)
NEXT_PUBLIC_SENTRY_DSN=
# 서버(route handler, 서버 컴포넌트)용. 보통 위와 같은 값
SENTRY_DSN=
# 선택. 없으면 VERCEL_ENV, 그다음 NODE_ENV
SENTRY_ENVIRONMENT=

# (#195) 카카오 JavaScript 키 (공개값, 빌드 때 번들에 박힘). 비면 카카오톡 공유 버튼이 OS 공유 시트/링크 복사로 동작
# 카카오 콘솔 > 플랫폼 > Web 사이트 도메인에 이 주소가 있어야 한다 (docs/운영/카카오-개발자센터.md)
NEXT_PUBLIC_KAKAO_JS_KEY=

# (#199) 일정 상세 카카오 지도. 지도 전용 카카오 앱의 "언제볼까 지도" JavaScript 키 (공유 키와 다른 앱). 비우면 지도 없음
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# 아래는 넣지 않는다 (자동): NODE_ENV, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA (Vercel 이 주입).
# NEXT_PUBLIC_WEB_VERSION, NEXT_PUBLIC_COMMIT_SHA, SENTRY_CLIENT_* 는 next.config.ts 가 빌드 때 만든다

# (D-259) 네이버 지도 JS v3 의 ncpKeyId (네이버 클라우드 Maps Application 의 Client ID, 공개 값). 허용 도메인 whenwemeet.day, localhost:3000. 비우면 네이버 지도 칸을 숨긴다
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
