// 이슈: #2
// 언제볼까 Prisma 스키마 초안 (Prisma 7 / MySQL 8)
// - 접속 URL 은 apps/api/prisma.config.ts 의 datasource.url = env("DATABASE_URL") 로 설정 (결정기록 D-01)
// - 모든 DateTime 은 UTC. 클라이언트가 KST 로 변환
// - 모든 PK/FK 는 Int 자동증가 (결정기록 D-35). 모든 접근은 멤버십 검사를 거치고 초대는 별도 6자리 코드

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// 팀 종류. PERSONAL 은 가입 시 자동 생성되는 1인 팀, TEAM 은 이름을 지어 만드는 여럿 팀
enum GroupType {
  PERSONAL
  TEAM
}

/// 새 소식에 남기는 일정 변경 종류
enum EventLogAction {
  CREATED
  UPDATED
  DELETED
}

/// (#187) 반복 주기. 기준은 첫 회차 시작일 (기획 3-1)
/// (D-259) 고른 장소의 출처 (Event.placeProvider, EventException.placeProvider)
enum PlaceProvider {
  KAKAO
  NAVER
}

enum EventRepeat {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
  /// (#562) 매년 음력. 기준 날짜(repeatAnchor ?? 첫 회차)의 음력 월일로 해마다 양력 날짜를 구한다 (D-297)
  YEARLY_LUNAR
}

/// (#562) 기념일, 생일 날짜의 달력 종류. LUNAR 면 저장한 날짜가 음력 월일 (D-297)
enum CalendarType {
  SOLAR
  LUNAR
}

/// (#187) 반복 일정의 수정/삭제 범위. 새 소식 문구용
enum EventLogScope {
  THIS
  FOLLOWING
}

/// 사용자. 소셜 로그인(AuthAccount)으로만 생성. 탈퇴 시 행을 물리 삭제한다 (개인정보 즉시 삭제)
model User {
  id           Int      @id @default(autoincrement())
  /// 우리 서비스의 표시 이름. 가입 시 소셜 닉네임을 복사하고 이후 재로그인해도 덮지 않는다 (D-36)
  nickname     String   @db.VarChar(50)
  /// 프로필 사진 (File, D-38). 가입 시 소셜 프로필 사진을 R2 로 복사해 채운다. 없으면 이니셜 아바타
  avatarFileId Int?     @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// (#188) 마지막 앱 로그인 (handoff 교환 성공). 권한 허용률 지표의 분모 (D-97)
  lastAppLoginAt    DateTime?
  /// (#300) 처음 여는 달력. 기본 LAST(마지막에 본 달력). GROUP 이면 startGroupId 의 팀 (D-191)
  startCalendarMode StartCalendarMode @default(LAST)
  /// (#300) GROUP 일 때만 값. 그 팀에서 나가거나 팀이 지워지면 같은 트랜잭션에서 LAST 로 되돌린다 (D-192)
  startGroupId      Int?
  /// (#305) 내 생일 'MM-DD' (연도 없음, 선택). 내가 속한 팀 달력에 "OO 생일" 로 매년 계산해 보인다 (행을 복사하지 않음, D-230)
  birthday          String?   @db.Char(5)
  /// (#562) 생일 달력 종류. LUNAR 면 birthday 가 음력 월일 (D-297)
  birthdayCalendar  CalendarType @default(SOLAR)
  /// (#562) 음력 생일이 윤달인지. 그 윤달이 없는 해는 평달 (D-297)
  birthdayLeapMonth Boolean   @default(false)
  /// (#562) 달력 칸에 음력 날짜 작게 보이기. 기본 끔 (D-297)
  showLunar         Boolean   @default(false)
  /// (#450) AI 비서 처음 쓸 때 안내에 동의한 시각. null = 아직 (D-270)
  assistantConsentAt DateTime?
  /// (#515) 역할. admin 은 공지 작성과 사용자 역할 변경(관리자 화면). 첫 관리자는 운영자가 SQL 로 지정 (D-285)
  role               UserRole  @default(user)
  /// (#515) 공지 목록을 마지막으로 본 시각. 이보다 늦게 게시된 공지가 있으면 내 정보에 점. null = 아직 안 봄 (D-285)
  noticesSeenAt      DateTime?

  avatar        File?         @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  files         File[]        @relation("FileOwner")
  authAccounts  AuthAccount[]
  authHandoffs  AuthHandoff[]
  /// (#198) 내가 시작한 로그인 방법 연결의 1회용 티켓
  authLinkTickets AuthLinkTicket[]
  memberships   Membership[]
  createdEvents Event[]       @relation("EventCreator")
  anniversaries Anniversary[] @relation("AnniversaryCreator")
  eventLogs     EventLog[]    @relation("EventLogActor")
  /// (#191) 내가 한 팀 활동 기록
  groupActivities GroupActivity[] @relation("GroupActivityActor")
  pushDevices    PushDevice[]
  pushDeliveries PushDelivery[]
  /// (#279) 내가 한 ICS 가져오기
  eventImports   EventImport[]
  /// (#248) 참여하는 일정
  eventParticipations EventParticipant[]
  /// (#274) 내가 만든 일정 공유 링크
  eventShares    EventShare[]
  /// (#300) 처음 여는 달력으로 고정한 팀
  startGroup     Group?        @relation("UserStartGroup", fields: [startGroupId], references: [id], onDelete: SetNull)
  /// (#276) 할 일 목록, 항목
  todoListsCreated TodoList[] @relation("TodoListCreator")
  todoListsEdited  TodoList[] @relation("TodoListEditor")
  todoItemsCreated TodoItem[] @relation("TodoItemCreator")
  todoItemsDone    TodoItem[] @relation("TodoItemDoneBy")
  /// (#193) 팀별 외부 캘린더 구독 주소
  calendarFeeds    CalendarFeed[]
  /// (#190) 일정 회차별 내 참석 여부, 반응
  eventRsvps       EventRsvp[]
  eventReactions   EventReaction[]
  /// (#189) 내가 연 약속 투표, 내 표, 내가 대상인 투표
  pollsCreated       Poll[]            @relation("PollCreator")
  pollVotes          PollVote[]
  pollParticipations PollParticipant[]
  /// (#369) 알림 설정 (종류별 켬/끔, 생일 알림 시점). 행이 없으면 코드의 기본값 (D-249)
  notificationPreferences NotificationPreference[]
  /// (#369) 내 생일을 팀원에게 알리는 시점 (켜진 시점마다 행 하나, 가입 때 DAY_OF 하나, D-232)
  birthdayReminders       BirthdayReminder[]
  /// (#375) 내가 지운 일정의 되돌리기 보관
  eventDeletions          EventDeletion[]
  /// (#450) AI 비서 하루 사용 횟수
  assistantUsages         AssistantUsage[]
  /// (#515) 내가 쓴 공지
  notices                 Notice[]
  /// (#515) 내가 숨긴 팀, 일정과 관리자 조치 기록 (D-286)
  hiddenGroups            Group[]       @relation("GroupHiddenBy")
  hiddenEvents            Event[]       @relation("EventHiddenBy")
  adminActions            AdminAction[]
  /// (#532) 접속한 기종과 앱 버전 (기종마다 한 줄, D-288)
  clients                 UserClient[]
  /// (#538) 내가 닫은 팝업 공지 (D-291)
  noticeDismissals        NoticeDismissal[]
  /// (#544) 내가 처음 읽은 공지 (D-293)
  noticeReads             NoticeRead[]
  /// (#536) 내가 한 신고, 내가 처리한 신고 (D-289)
  reports                 Report[]      @relation("ReportReporter")
  resolvedReports         Report[]      @relation("ReportResolvedBy")

  /// (#537) 대시보드 날짜별 가입자 (D-290)
  @@index([createdAt])
}

/// (#515) 관리자 조치 종류 (D-286). 관리자 변경은 모두 한 줄씩 남긴다
enum AdminActionType {
  notice_create
  notice_update
  notice_delete
  user_role
  group_hide
  group_unhide
  group_delete
  event_hide
  event_unhide
  event_delete
  /// (#528) 공지 푸시 보냄 (D-287)
  notice_push
  /// (#539) 앱 최신, 최소 버전, 스토어 주소 변경 (D-292)
  app_release_update
  /// (#536) 신고 처리 완료, 기각 (D-289). targetType, targetId 는 신고 대상, reason 은 처리 메모
  report_resolve
  report_dismiss
}

/// (#515) 조치 대상 종류
enum AdminTargetType {
  notice
  user
  group
  event
  /// (#539) AppRelease (D-292)
  app_release
}

/// (#515) 관리자 조치 기록 (D-286). 대상이 지워져도 남는다(FK 없음, 번호만). 관리자가 탈퇴하면 adminId null
model AdminAction {
  id         Int             @id @default(autoincrement())
  adminId    Int?
  action     AdminActionType
  targetType AdminTargetType
  targetId   Int
  /// 숨김 사유, 역할 변경 내용 등 (200자)
  reason     String?         @db.VarChar(200)
  createdAt  DateTime        @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// (#536) 신고 대상 종류 (D-289)
enum ReportTargetType {
  group
  event
  user
}

/// (#536) 신고 사유. 스팸·광고, 욕설·괴롭힘, 불법, 개인정보 노출, 그 밖
enum ReportReason {
  spam
  abuse
  illegal
  privacy
  other
}

/// (#536) 신고 상태. 처리 완료(조치함), 기각(조치 없음)
enum ReportStatus {
  open
  resolved
  dismissed
}

/// (#536) 신고 한 건 (D-289). 대상은 FK 없이 종류와 번호만(대상이 지워져도 남는다). 같은 사람이 같은 대상을 접수 중에 다시 신고하면 새 행을 만들지 않는다.
/// 관리자는 대상별로 묶어 보고, 처리하면 그 대상의 접수 중 신고가 한꺼번에 닫힌다
model Report {
  id           Int              @id @default(autoincrement())
  /// 신고한 사람. 탈퇴하면 null
  reporterId   Int?
  targetType   ReportTargetType
  targetId     Int
  reason       ReportReason
  /// 자세한 내용 (선택, 500자)
  detail       String?          @db.VarChar(500)
  status       ReportStatus     @default(open)
  resolvedById Int?
  resolvedAt   DateTime?
  /// 처리 메모 (200자)
  resolution   String?          @db.VarChar(200)
  createdAt    DateTime         @default(now())

  reporter   User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

/// (#515) 사용자 역할 (D-285). 값은 소문자 그대로 (운영 SQL `role='admin'`)
enum UserRole {
  user
  admin
}

/// (#515) 공지 종류 (D-285). 공지, 업데이트 소식, 점검 안내
enum NoticeKind {
  notice
  update
  maintenance
}

/// (#515) 서비스 공지 (D-285). 누구나 읽고 관리자만 쓴다. publishedAt 이 null 이면 초안(관리자만 보임)
model Notice {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(100)
  /// 일반 텍스트. 빈 줄로 문단을 나누고 https 주소는 화면이 링크로 그린다 (HTML 아님)
  body        String     @db.Text
  kind        NoticeKind @default(notice)
  /// 목록 맨 위 고정
  pinned      Boolean    @default(false)
  /// 게시 시각. null = 초안
  publishedAt DateTime?
  /// (#528) 푸시를 보낸(예약한) 시각. 한 공지는 한 번만 보낸다 (D-287)
  pushedAt    DateTime?
  /// (#538) 앱, 웹을 열 때 한 번 창으로 띄운다. 사용자가 닫으면 NoticeDismissal 이 남는다 (D-291)
  popup       Boolean    @default(false)
  /// 쓴 관리자. 탈퇴하면 null
  createdById Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// (#538) 이 팝업을 닫은 사용자들
  dismissals NoticeDismissal[]
  /// (#544) 이 공지를 읽은 사용자들 (처음 한 번)
  reads      NoticeRead[]

  @@index([publishedAt])
}

/// (#538) 팝업 공지를 닫은 기록 (D-291). 사용자 + 공지당 한 행. 기기가 바뀌어도 다시 띄우지 않는다
model NoticeDismissal {
  userId    Int
  noticeId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@id([userId, noticeId])
  @@index([noticeId])
}

/// (#544) 공지를 처음 연 경로 (D-293). list = 공지 목록, detail = 그 밖(주소 직접, 공유 링크 등), push = 푸시 누름, popup = 팝업 자세히 보기, banner = 달력 위 새 공지 띠
enum NoticeReadVia {
  list
  detail
  push
  popup
  banner
}

/// (#544) 로그인한 사용자가 게시된 공지 상세를 처음 연 기록 (D-293). 사용자 + 공지당 한 행, 처음 것만 남긴다(다시 열어도 바꾸지 않음).
/// 로그인하지 않고 읽은 경우는 셀 수 없다
model NoticeRead {
  userId      Int
  noticeId    Int
  firstReadAt DateTime      @default(now())
  via         NoticeReadVia

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@id([userId, noticeId])
  /// 관리자 읽은 사람 목록 (공지별 읽은 시각 내림차순)
  @@index([noticeId, firstReadAt])
}

/// (#450) AI 비서 하루 사용 횟수. 사용자 + KST 날짜당 한 행 (D-269). 대화, 답은 어디에도 저장하지 않는다
model AssistantUsage {
  userId Int
  /// KST 달력 날짜
  day    DateTime @db.Date
  count  Int      @default(0)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  /// (#537) 대시보드 날짜별 볼까 사용량 (D-290)
  @@index([day])
}

/// (#369) 사용자별 알림 종류 (내 정보 > 알림 토글, D-249). 기본값은 코드 표 `notification-preferences/notification-preferences.ts` 하나
enum NotificationPreferenceKind {
  /// 일정 알림 (기본 켬)
  REMINDER
  /// 팀원 변경 (기본 켬)
  CHANGE
  /// 기념일, 멤버 생일 (기본 켬)
  ANNIVERSARY
  /// 새 멤버 합류 (기본 켬)
  JOIN
  /// (#277) 주간 요약 (기본 켬, D-204)
  WEEKLY
  /// (#277) 다 같이 비는 시간, 조용한 팀 깨우기 (기본 끔, D-204)
  WEEKLY_NUDGE
  /// (#189) 약속 투표 (기본 켬)
  POLL
  /// (#528) 공지 (기본 켬, D-287)
  NOTICE
}

/// (#369) 사용자 알림 설정 한 칸 (D-249). 행이 없으면 기본값, 있으면 사용자가 고른 값. 탈퇴하면 Cascade
model NotificationPreference {
  userId    Int
  kind      NotificationPreferenceKind
  enabled   Boolean
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

/// (#369) 알림 시점, 모두 오전 9시 KST (D-144). 기념일 알림(#269)과 멤버 생일 알림(#305)이 같이 쓴다
enum ReminderOffset {
  DAY_OF
  DAY_BEFORE
  WEEK_BEFORE
}

/// (#369) 기념일의 알림 시점. 켜진 시점마다 행 하나, 행이 없으면 알림 없음 (D-249). 기념일이 지워지면 Cascade
model AnniversaryReminder {
  anniversaryId Int
  offset        ReminderOffset

  anniversary Anniversary @relation(fields: [anniversaryId], references: [id], onDelete: Cascade)

  @@id([anniversaryId, offset])
}

/// (#369) 내 생일을 팀원에게 알리는 시점. 켜진 시점마다 행 하나, 행이 없으면 알림 없음 (D-249). 탈퇴하면 Cascade
model BirthdayReminder {
  userId Int
  offset ReminderOffset

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, offset])
}

/// (#300) 처음 여는 달력. LAST 마지막에 본 달력(쿠키 wwm_group), PERSONAL 내 달력(개인 팀), GROUP 고정한 팀
enum StartCalendarMode {
  LAST
  PERSONAL
  GROUP
}

/// 소셜 로그인 제공자. DEV 는 개발 환경 전용(dev-login)
enum AuthProvider {
  KAKAO
  APPLE
  GOOGLE
  NAVER
  DEV
  /// (#245) 이메일 링크/코드 로그인. providerUserId = 정규화한 이메일 (D-110)
  EMAIL
}

/// 사용자에 연결된 소셜 계정 (결정기록 D-34). 한 사용자에 여러 개 가능, MVP 는 KAKAO 하나, 앱 출시부터 APPLE
model AuthAccount {
  id               Int          @id @default(autoincrement())
  userId           Int
  provider         AuthProvider
  /// 제공자 쪽 사용자 식별자. 카카오 회원번호도 문자열로 저장 (D-28)
  providerUserId   String       @db.VarChar(191)
  /// 제공자가 준 이메일. 수집 동의 없으면 null
  email            String?      @db.VarChar(255)
  /// 제공자 쪽 원본 프로필. 로그인마다 갱신
  rawProfile       Json?
  /// 토큰을 발급받은 client_id (애플: 번들 ID 또는 Service ID). 탈퇴 시 폐기를 같은 값으로 호출 (앱.md 3.5)
  providerClientId String?      @db.VarChar(191)
  /// 제공자 refresh token (애플만). 탈퇴 시 revoke 에만 쓴다. 사용에 .p8 서명이 필요해 평문 저장 (D-51)
  refreshToken     String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// 앱 로그인 결과를 웹뷰 세션 쿠키로 넘기는 60초 1회용 토큰 (앱.md 2장, D-44, D-49)
model AuthHandoff {
  id            Int       @id @default(autoincrement())
  userId        Int
  /// sha256hex(토큰). 원문은 저장하지 않는다
  tokenHash     String    @unique @db.Char(64)
  /// base64url(sha256(verifier)). 교환 시 verifier 로 대조
  codeChallenge String    @db.VarChar(64)
  expiresAt     DateTime
  /// 교환된 시각. null 이 아니면 재사용 불가
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// (#198) 로그인 방법 연결: 웹 OAuth(카카오, Apple)로 받은 두 번째 로그인 결과. 세션이 아니다 (D-257).
/// 연결을 시작한 사용자에게 묶이고 5분 1회용. 원문은 주소에만 있고 여기에는 sha256hex 만. 하루 지난 행은 발급 때 지운다
model AuthLinkTicket {
  id               Int          @id @default(autoincrement())
  /// 연결을 시작한 사용자. 다른 사용자의 세션으로는 쓸 수 없다
  userId           Int
  /// sha256hex(티켓)
  tokenHash        String       @unique @db.Char(64)
  provider         AuthProvider
  providerUserId   String       @db.VarChar(191)
  email            String?      @db.VarChar(255)
  rawProfile       Json?
  /// Apple 토큰 폐기용 (D-51). Apple 만
  providerClientId String?      @db.VarChar(191)
  refreshToken     String?      @db.Text
  expiresAt        DateTime
  /// 소비한 시각. null 이 아니면 재사용 불가
  usedAt           DateTime?
  createdAt        DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// (#198) 이메일 메일의 쓰임. LOGIN 로그인(링크 + 코드), LINK 로그인한 사용자의 이메일 연결(코드만, D-257)
enum EmailLoginPurpose {
  LOGIN
  LINK
}

/// (#245) 이메일 로그인 메일 1통 = 1행. 링크와 코드, 틀린 횟수, 횟수 제한의 근거, 처음 가입 티켓까지 담는다 (D-111)
/// User 와 FK 없음(가입 전에도 생긴다). 탈퇴 시 같은 email 행을 지운다. 30일 뒤 삭제
model EmailLoginChallenge {
  id                Int             @id @default(autoincrement())
  /// 정규화한 이메일 (trim + 소문자, 191자 이하)
  email             String          @db.VarChar(191)
  /// sha256hex(링크 토큰). 원문은 메일에만 있다
  linkTokenHash     String          @unique @db.Char(64)
  /// HMAC-SHA256(코드 키, `${linkTokenHash}:${code}`) hex. 심사 계정은 REVIEW_CODE 로 같은 식 (D-112, D-118)
  codeHash          String          @db.Char(64)
  /// 틀린 코드 횟수. 5 가 되면 invalidatedAt 을 채운다
  attempts          Int             @default(0)
  expiresAt         DateTime
  /// 링크나 코드로 로그인(또는 가입 티켓 발급)된 시각. 채워지면 링크, 코드 둘 다 끝
  usedAt            DateTime?
  usedVia           EmailLoginVia?
  /// 새로 받아서, 또는 5번 틀려서 무효가 된 시각
  invalidatedAt     DateTime?
  /// 로그인 후 갈 웹 경로 + 쿼리 (sanitizeNext 거친 값, 512자)
  next              String          @default("/") @db.VarChar(512)
  /// HMAC-SHA256(IP 키, 클라이언트 IP) hex. IP 원문은 저장하지 않는다 (D-112)
  ipHash            String          @db.Char(64)
  isReview          Boolean         @default(false)
  sendStatus        EmailSendStatus
  /// Resend 응답 id. 도착 시간을 Resend 로그에서 찾을 때 쓴다
  providerMessageId String?         @db.VarChar(64)
  /// 처음 가입 티켓 sha256hex. 닉네임 제출 때 1회 소비하고 null 로 (D-114)
  signupTokenHash   String?         @unique @db.Char(64)
  signupExpiresAt   DateTime?
  /// (#198) LOGIN 이 아니면 로그인에 쓰지 못한다. LINK 는 userId 사용자만 연결에 쓴다 (D-257)
  purpose           EmailLoginPurpose @default(LOGIN)
  /// (#198) LINK 를 요청한 사용자. FK 없음(이 표는 User 와 FK 를 두지 않는다). 탈퇴, 흡수 때 같은 userId 행을 지운다
  userId            Int?
  createdAt         DateTime        @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

/// (#245) 이메일 로그인이 쓰인 방법
enum EmailLoginVia {
  LINK
  CODE
}

/// (#245) 로그인 메일 발송 결과
enum EmailSendStatus {
  /// Resend 가 받음(2xx)
  SENT
  /// Resend 오류, 시간 초과. 화면은 같다
  FAILED
  /// 심사 계정 (보내지 않음) 또는 개발용 콘솔 출력
  SKIPPED
}

/// 팀. personal / team 모두 같은 모델. 마지막 멤버가 나가면 삭제
model Group {
  id         Int       @id @default(autoincrement())
  type       GroupType
  name       String    @db.VarChar(30)
  /// 6자리 초대 코드. 초대 링크(/join/<code>)와 같은 값. PERSONAL 은 null (초대 불가)
  inviteCode String?   @unique @db.Char(6)
  /// (#311) 주소(`?team=`), 알림, 위젯에서 번호 대신 쓰는 공개 코드. 소문자 영숫자 8자 (common/public-code.ts). 초대 권한 없음
  publicCode String    @unique @db.Char(8)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// (#515) 운영 숨김 (D-286). 값이 있으면 운영 정책 위반으로 숨긴 상태. 사유는 필수(200자), 숨긴 관리자는 탈퇴하면 null
  hiddenAt     DateTime?
  hiddenReason String?   @db.VarChar(200)
  hiddenById   Int?
  hiddenBy     User?     @relation("GroupHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  memberships       Membership[]
  events            Event[]
  anniversaries     Anniversary[]
  eventLogs         EventLog[]
  pushNotifications PushNotification[]
  /// (#191) 새 소식의 일정 밖 기록
  activities        GroupActivity[]
  /// (#279) ICS 파일 가져오기 기록
  eventImports      EventImport[]
  /// (#274) 일정 공유 링크
  eventShares       EventShare[]
  /// (#300) 이 팀을 처음 여는 달력으로 고정한 사용자
  startUsers        User[]       @relation("UserStartGroup")
  /// (#276) 할 일 목록
  todoLists         TodoList[]
  /// (#193) 멤버별 외부 캘린더 구독 주소
  calendarFeeds     CalendarFeed[]
  /// (#189) 약속 투표
  polls             Poll[]
  /// (#375) 되돌릴 수 있게 보관한 일정 삭제
  eventDeletions    EventDeletion[]
}

/// 사용자-팀 소속. 팀별 색/표시 이름과 새 소식 기준 시각을 가진다
model Membership {
  id          Int      @id @default(autoincrement())
  userId      Int
  groupId     Int
  /// 달력에서 이 멤버의 일정을 구분하는 색. #RRGGBB
  color       String   @db.Char(7)
  /// 이 팀에서만 쓰는 표시 이름. null 이면 User.nickname 사용
  displayName String?  @db.VarChar(20)
  /// 새 소식 화면을 마지막으로 연 시각. 이 시각 이후의 EventLog 가 "새 소식"
  lastSeenAt  DateTime @default(now())
  joinedAt    DateTime @default(now())
  /// (#188) 팀 설정 "이 팀 알림 받기". 기본 켬
  notify      Boolean  @default(true)
  /// (#305) 팀 설정 "이 팀 달력에 내 생일 보이기". 기본 켬 (D-231)
  showBirthday Boolean @default(true)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

/// 일정. 팀의 자산이므로 등록자가 나가거나 탈퇴해도 남는다
model Event {
  id           Int          @id @default(autoincrement())
  groupId      Int
  /// (#311) 주소(`/events/<code>`)에서 번호 대신 쓰는 공개 코드. 소문자 영숫자 8자 (common/public-code.ts)
  publicCode   String       @unique @db.Char(8)
  title        String       @db.VarChar(50)
  /// 시작 (UTC). 종일 일정은 KST 00:00 에 해당하는 UTC 시각
  startsAt     DateTime
  /// 종료 (UTC, 배타적). 종일 일정은 다음 날 KST 00:00
  endsAt       DateTime
  allDay       Boolean      @default(false)
  memo         String?      @db.VarChar(500)
  /// 등록자. 탈퇴하면 null 이 되고 화면에는 "탈퇴한 멤버" 로 표시
  creatorId    Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  /// (#187) null 이면 한 번짜리
  repeat       EventRepeat?
  /// (#187) 반복 종료일 (KST 날짜, 그날 시작하는 회차 포함). null 이면 계속
  repeatUntil  DateTime?    @db.Date
  /// (#228) 반복 기준 날짜 (KST). MONTHLY 는 이 날짜의 일, YEARLY 는 월일로 회차 날짜를 정한다 (말일 보정 그대로).
  /// null 이면 startsAt 의 KST 날짜. "이후 모두" 로 나눈 새 원본이 말일 보정된 회차에서 시작해도 원래 날짜를 잇는다 (D-71)
  repeatAnchor DateTime?    @db.Date
  /// (#188) 알림 시각. 기본 없음
  reminder      EventReminder @default(NONE)
  /// (#188) 한 번짜리 일정의 알림 시각(UTC). 반복 원본이거나 NONE 이면 null. 저장할 때 계산 (D-85)
  remindAt      DateTime?
  /// (#188) 알림 시각을 정하는 값(시작, 끝, 종일, 알림, 반복, 반복 종료일)을 마지막으로 바꾼 시각 (D-86)
  reminderSetAt DateTime      @default(now())
  /// (#248) true 면 "모두": 그 팀 멤버 전체 (동적). false 면 participants 행, 0 이면 "참여자 없음" (D-130)
  /// (#444) "모두" 는 더 저장하지 않는다. 기존 true 행은 마이그레이션 시점 멤버 행으로 바꾸고 기본값은 false (D-263).
  /// true 는 배포 중 옛 API 가 만든 행에만 남을 수 있고, 읽기는 계속 "지금 멤버 전원" 으로 처리한다
  allMembers    Boolean       @default(false)
  /// (#343) 일정 색. 멤버 색 키 8개(common/member.ts MEMBER_COLORS) 중 하나. null 이면 자동(참여자 색) (D-215).
  /// 반복 일정은 원본 단위 (회차 예외 없음)
  color         String?       @db.Char(7)
  /// (#199) 장소 (D-242). 카카오 정책상 카카오가 준 이름, 주소, 좌표는 저장하지 않는다. 보일 때마다 placeQuery 로 다시 찾아 placeId 를 고른다.
  /// placeId: 고른 장소의 식별자(카카오 장소 ID, 또는 네이버 장소 키 = 이름 + 주소 sha256 앞 16자, D-259). placeQuery: 고를 때 사용자가 적은 검색어.
  /// placeText: 고르지 않고 적은 장소 글자. 셋 다 null 이면 장소 없음
  placeId       String?       @db.VarChar(20)
  /// (D-259) placeId 의 출처. null 이면 카카오 (이전 행). 직접 적은 장소는 null
  placeProvider PlaceProvider?
  placeQuery    String?       @db.VarChar(100)
  placeText     String?       @db.VarChar(100)
  /// (#515) 운영 숨김 (D-286). 값이 있으면 운영 정책 위반으로 숨긴 상태. 사유는 필수(200자), 숨긴 관리자는 탈퇴하면 null
  hiddenAt     DateTime?
  hiddenReason String?   @db.VarChar(200)
  hiddenById   Int?
  hiddenBy     User?     @relation("EventHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  group        Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator      User?              @relation("EventCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  logs         EventLog[]
  exceptions   EventException[]
  participants EventParticipant[]
  /// (#279) ICS 가져오기로 들어온 일정이면 그 기록 (원본 UID 해시)
  importItems  EventImportItem[]
  /// (#274) 이 일정(회차)을 팀 밖에 보여주는 링크
  shares       EventShare[]
  /// (#190) 회차별 참석 여부, 반응
  rsvps        EventRsvp[]
  reactions    EventReaction[]
  /// (#189) 이 일정을 정한 약속 투표 (투표로 정해 생긴 일정만)
  poll         Poll?

  @@index([groupId, startsAt])
  @@index([groupId, endsAt])
  @@index([groupId, repeat])
  @@index([remindAt])
  @@index([reminder, repeat])
}

/// (#187) 반복 일정 회차 하나의 예외. "이 일정만" 수정/삭제 (D-65)
model EventException {
  id         Int       @id @default(autoincrement())
  eventId    Int
  /// 원래 회차 날짜 (KST). 회차를 옮겨도 이 값은 그대로
  occurrence DateTime  @db.Date
  /// true 면 그 회차는 없다 (아래 값 무시)
  cancelled  Boolean   @default(false)
  /// 바꾼 값. null 이면 원본 값. 메모를 지운 회차는 ''
  title      String?   @db.VarChar(50)
  startsAt   DateTime?
  endsAt     DateTime?
  allDay     Boolean?
  memo       String?   @db.VarChar(500)
  updatedAt  DateTime  @updatedAt
  /// (#188) 이 회차의 알림. null 이면 원본 값
  reminder      EventReminder?
  /// (#188) 이 회차의 시각이나 알림을 바꾼 시각. null 이면 원본 값
  reminderSetAt DateTime?
  /// (#199) 이 회차의 장소. 셋 다 null 이면 원본 장소, placeText 가 '' 이고 나머지가 null 이면 이 회차만 장소 없음 (메모와 같은 규칙, D-65).
  /// 그 밖이면 셋(+ 출처)이 원본 장소 전체를 대신한다
  placeId       String?   @db.VarChar(20)
  /// (D-259) placeId 의 출처. null 이면 카카오 (이전 행)
  placeProvider PlaceProvider?
  placeQuery    String?   @db.VarChar(100)
  placeText     String?   @db.VarChar(100)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrence])
}

/// (#248) 일정 참여자 (allMembers = false 일 때만 행이 있다). 반복이면 원본에만 붙는다 (기획 3-5). (#444) 전원 일정도 이 행으로 (D-263)
model EventParticipant {
  eventId Int
  userId  Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

/// (#190) 참석 여부 3값. 응답 안 함은 행이 없다
enum RsvpStatus {
  GOING
  NOT_GOING
  MAYBE
}

/// (#190) 짧은 반응 3개. 화면 글자: 좋아요, 기대돼요, 확인했어요 (이모지 없음)
enum EventReactionKind {
  LIKE
  EXCITED
  ACK
}

/// (#190) 일정 회차 하나에 대한 참여자의 참석 여부 (D-224). 반복이면 (eventId, 원래 회차 날짜), 한 번짜리는 시작 KST 날짜.
/// 참여자에서 빠지거나 팀을 나가면 지운다. 한 번짜리 날짜를 옮기면 occurrence 도 같은 트랜잭션에서 옮긴다
model EventRsvp {
  eventId    Int
  /// 회차 날짜 (KST). nullable 이면 MySQL 유일 키가 안 먹어 한 번짜리도 날짜를 넣는다
  occurrence DateTime   @db.Date
  userId     Int
  status     RsvpStatus
  /// 응답할 때 본 그 회차의 시작, 끝. 지금 회차 시각과 다르면 "응답한 뒤 시간이 바뀌었어요" (D-226)
  seenStartsAt DateTime
  seenEndsAt   DateTime
  updatedAt  DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, occurrence, userId])
  @@index([userId])
}

/// (#190) 일정 회차 하나에 대한 팀원의 짧은 반응. 사람당 하나 (D-224)
model EventReaction {
  eventId    Int
  occurrence DateTime          @db.Date
  userId     Int
  kind       EventReactionKind
  createdAt  DateTime          @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, occurrence, userId])
  @@index([userId])
}

/// (#274) 일정 하나(반복이면 회차 하나)를 팀 밖에 보여주는 링크 (D-181). 살아 있는 링크 = revokedAt null 이고 expiresAt 이 지나지 않음.
/// 같은 (eventId, occurrence) 의 살아 있는 링크는 하나 (서비스가 트랜잭션 안에서 확인, nullable 유니크는 DB 로 막지 않는다)
model EventShare {
  id          Int       @id @default(autoincrement())
  /// 16바이트 랜덤 base64url 22자. 대소문자 구분
  token       String    @unique @db.VarChar(32)
  groupId     Int
  eventId     Int
  /// 반복 회차의 원래 날짜 (KST). 한 번짜리는 null
  occurrence  DateTime? @db.Date
  /// 만든 사람. 탈퇴하면 null (나가기, 탈퇴 때 그 사람 링크는 먼저 끊는다)
  createdById Int?
  createdAt   DateTime  @default(now())
  /// 그 회차 끝 + 1일, 만든 때 + 30일 중 이른 쪽 (D-183)
  expiresAt   DateTime
  /// 끊은 시각. 끊기, 초대 코드 재발급, 만든 사람 나감
  revokedAt   DateTime?
  /// 이 링크로 새로 합류한 사람 수 (이미 멤버는 세지 않는다)
  joinCount   Int       @default(0)

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId, occurrence])
  @@index([groupId])
  @@index([createdById])
}

/// 기념일. 날짜만 가지며 D-day 계산은 클라이언트가 한다
model Anniversary {
  id        Int             @id @default(autoincrement())
  groupId   Int
  name      String          @db.VarChar(30)
  /// 기념일 날짜 (KST 달력 날짜). 시각 없음
  date      DateTime        @db.Date
  /// (#105) 자동 표시 종류. 기존 행은 COUNT_UP. 항목 계산은 클라이언트 (D-60)
  kind      AnniversaryKind @default(COUNT_UP)
  /// (#562) 달력 종류. LUNAR 면 date 가 음력 연월일 (D-297)
  calendar  CalendarType    @default(SOLAR)
  /// (#562) 음력 날짜가 윤달인지. 그 윤달이 없는 해는 평달 (D-297)
  isLeapMonth Boolean       @default(false)
  creatorId Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User? @relation("AnniversaryCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  /// (#191) 이 기념일의 새 소식 기록. 기념일이 지워지면 anniversaryId 만 null
  activities GroupActivity[]
  /// (#269, #369) 알림 시점 (켜진 시점마다 행 하나). 일주일 전은 100일 단위 항목에 쓰지 않음 (D-144, D-145)
  reminders  AnniversaryReminder[]

  @@index([groupId, date])
}

/// 새 소식용 일정 변경 이력. 일정이 삭제돼도 남아야 하므로 제목/시각을 스냅샷으로 복사해 둔다
model EventLog {
  id         Int            @id @default(autoincrement())
  groupId    Int
  /// 원본 일정. 삭제되면 null (스냅샷 필드로 표시)
  eventId    Int?
  /// 변경한 사람. 탈퇴하면 null
  actorId    Int?
  action     EventLogAction
  /// 변경 시점의 제목/시각 스냅샷
  title      String         @db.VarChar(50)
  startsAt   DateTime
  endsAt     DateTime
  allDay     Boolean
  createdAt  DateTime       @default(now())
  /// (#187) 변경 시점의 반복 주기 (한 번짜리면 null)
  repeat     EventRepeat?
  /// (#187) 반복 일정에서 고른 범위. 한 번짜리, 새 반복 추가는 null
  scope      EventLogScope?
  /// (#187) 범위를 고른 회차 날짜 (KST)
  occurrence DateTime?      @db.Date
  /// (#248) 변경 시점의 참여자 스냅샷 (지표용, D-136). 이 기능 전 로그와 DELETED 는 null
  participantsAll Boolean?
  /// (#248) allMembers = false 일 때의 userId 배열 (오름차순). "모두" 면 null
  participantIds  Json?

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actor User?  @relation("EventLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
}

/// (#375) 되돌릴 수 있는 삭제의 종류 (D-251). EVENT: 일정 행 자체를 지움(한 번짜리, 반복 첫 회차 "이후 모두").
/// OCCURRENCE: "이 일정만" (회차 취소 예외). FOLLOWING: 그 뒤 회차 "이후 모두" (원본 종료일을 당김)
enum EventDeletionKind {
  EVENT
  OCCURRENCE
  FOLLOWING
}

/// (#375) 일정 삭제 되돌리기 보관 (D-251). 삭제 트랜잭션이 지우거나 바꾸는 행을 삭제 직전 모습 그대로 snapshot(JSON)에 담는다.
/// 일정 읽기 경로는 이 표를 모른다(지운 일정은 지금처럼 진짜로 없다). 되돌리면 행을 다시 넣고 이 행을 지운다. 7일 지나면 틱이 지운다
model EventDeletion {
  id         Int               @id @default(autoincrement())
  groupId    Int
  /// 지운 일정(반복이면 원본) 번호. 행이 없을 수 있어 FK 를 걸지 않는다
  eventId    Int
  kind       EventDeletionKind
  /// OCCURRENCE, FOLLOWING 의 회차 날짜 (KST). EVENT 는 null
  occurrence DateTime?         @db.Date
  /// 지운 사람. 탈퇴하면 null
  actorId    Int?
  /// 삭제로 남긴 DELETED 로그. 되돌리면 이 로그를 지워 새 소식에서 숨긴다. FK 없음
  eventLogId Int?
  /// 되돌릴 행들 (형식은 event-deletions/deletion-snapshot.ts)
  snapshot   Json
  createdAt  DateTime          @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([actorId])
  @@index([createdAt])
}

/// (#191) 새 소식의 일정 밖 기록 종류 (D-150). #190 EVENT_RSVP, #189 POLL_CREATED/POLL_CLOSED 등은 여기에 더한다
enum GroupActivityType {
  ANNIVERSARY_CREATED
  ANNIVERSARY_UPDATED
  ANNIVERSARY_DELETED
  MEMBER_JOINED
  MEMBER_LEFT
  /// 탈퇴. 탈퇴자의 소속 TEAM 마다 한 줄, actorId 는 User 삭제로 null 이 된다
  MEMBER_DELETED
  GROUP_RENAMED
  /// (#279) ICS 파일로 일정을 가져옴. payload { count } (D-166)
  EVENTS_IMPORTED
  /// (#190) 참석 여부를 정하거나 바꿈. payload { eventId, eventCode, occurrence, title, startsAt, status }. 2분 안 같은 회차는 한 줄 (D-227)
  EVENT_RSVP
  /// (#189) 약속 투표를 열었다. payload { pollId, code, title }
  POLL_CREATED
  /// (#189) 약속 투표에서 시간을 정했다. payload { pollId, code, title, eventId, eventCode, eventLogId, startsAt, endsAt, allDay }.
  /// 그 확정으로 생긴 EventLog CREATED(eventLogId) 는 새 소식에서 숨긴다 (D-236)
  POLL_CLOSED
}

/// (#191) 팀에 생긴 일(기념일 변경, 멤버 합류와 나가기, 팀 이름 변경). 새 소식이 EventLog 와 합쳐 보여 준다 (D-150).
/// 쓰기는 서버만, 바뀐 일과 한 트랜잭션. 일정 기록(EventLog)과 푸시 묶음은 건드리지 않는다
model GroupActivity {
  id            Int               @id @default(autoincrement())
  groupId       Int
  type          GroupActivityType
  /// 한 사람. 탈퇴하면 null
  actorId       Int?
  /// 기록 시점의 표시 이름 스냅샷. 나간 사람, 탈퇴자 표시에 쓴다 (D-152)
  actorName     String            @db.VarChar(50)
  /// 기념일 3종의 대상. 기념일이 지워지면 null
  anniversaryId Int?
  /// 종류별 값. 기념일 { name, date, kind, changed?, before? }, 팀 이름 { from, to }, 멤버 3종 null
  payload       Json?
  createdAt     DateTime          @default(now())

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor       User?        @relation("GroupActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  anniversary Anniversary? @relation(fields: [anniversaryId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
}

/// (#279) ICS 파일 가져오기 한 번 (D-165). 일정 200개마다 나눠 커밋하고 다 넣으면 doneAt.
/// 나중에 "가져오기 되돌리기" 를 붙일 수 있게 남긴다 (기획 Q6). 파일 자체는 저장하지 않는다
model EventImport {
  id        Int       @id @default(autoincrement())
  groupId   Int
  /// 올린 사람. 탈퇴하면 null
  userId    Int?
  /// 실제로 넣은 일정 수 (배치마다 늘어난다)
  created   Int       @default(0)
  /// 끝까지 넣은 시각. null 이면 진행 중이거나 중간에 실패
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  group Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items EventImportItem[]

  @@index([groupId])
  @@index([userId])
}

/// (#279) 가져온 일정 하나의 원본 키. (팀, uidHash) 가 유일해 같은 파일을 다시 올려도 다시 들어가지 않는다 (D-165).
/// 원본 UID 원문은 저장하지 않는다. 일정을 지워도 행은 남아(eventId null) 다시 들어가지 않는다 (기획 Q5)
model EventImportItem {
  importId Int
  groupId  Int
  /// SHA-256 hex. 한 번짜리와 옮긴 반복은 UID, 펼친 회차는 UID@회차 시작, 따로 넣은 바뀐 회차는 UID#RECURRENCE-ID,
  /// UID 가 없으면 (제목, 시작, 끝)
  uidHash  String  @db.Char(64)
  eventId  Int?

  import EventImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  event  Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@id([importId, uidHash])
  @@unique([groupId, uidHash])
  @@index([eventId])
}

/// (#105) 기념일 종류
/// COUNT_UP: 시작일 = 1일로 세어 100일 단위(1000일까지, 이후 1000일 단위)와 N주년 표시 (처음 만난 날)
/// YEARLY: 매년 같은 월일 표시, 2/29 는 평년 2/28 (생일)
/// ONCE: 그날 하나만 (시험일)
enum AnniversaryKind {
  COUNT_UP
  YEARLY
  ONCE
}

/// 저장소 종류
enum StorageProvider {
  R2
  LOCAL
}

/// 파일 용도
enum FileKind {
  AVATAR
  EVENT_PHOTO
  GROUP_COVER
}

/// 저장된 파일 한 건 (D-38). 모든 이미지/첨부는 이 테이블을 거친다
model File {
  id        Int             @id @default(autoincrement())
  provider  StorageProvider @default(R2)
  /// 버킷명 (개발/운영이 다르므로 기록)
  bucket    String          @db.VarChar(100)
  /// 객체 키. 예: avatars/12/01JCK....webp
  key       String          @db.VarChar(300)
  mimeType  String          @db.VarChar(100)
  /// 바이트
  size      Int
  width     Int?
  height    Int?
  kind      FileKind
  /// 올린 사람. 탈퇴 시 이 사용자의 파일을 한 번에 정리
  ownerId   Int
  /// 외부에서 복사해 온 경우 원본 주소 (카카오 프로필 CDN 등). 우리 도메인이 아니라 출처 기록이므로 그대로 저장. 응답에 쓰지 않음
  sourceUrl String?         @db.VarChar(500)
  createdAt DateTime        @default(now())

  owner        User  @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarOfUser User? @relation("UserAvatar")

  @@unique([bucket, key])
  @@index([ownerId, kind])
}

/// (#188) 일정 알림 시각. 시간 일정은 AT_START ~ DAY_1, 종일 일정은 DAY_OF_0900, DAY_BEFORE_0900 (D-84)
enum EventReminder {
  NONE
  AT_START
  MIN_10
  HOUR_1
  DAY_1
  DAY_OF_0900
  DAY_BEFORE_0900
}

/// (#188) 기기 OS
enum DevicePlatform {
  IOS
  ANDROID
}

/// (#532) 로그인한 요청이 온 기종 (D-288). 앱 셸 User-Agent 의 `WhenwemeetApp/<버전> (ios|android)`, 그 밖은 web
enum ClientPlatform {
  ios
  android
  web
}

/// (#532) 사용자별 접속 기종 기록 (D-288). 웹 프록시가 넘긴 User-Agent 에서 기종과 앱 버전만 뽑아 남긴다(원문 저장 안 함).
/// 같은 사용자, 기종은 1시간에 한 번만 갱신. 배포 뒤 접속한 사람부터 쌓인다
model UserClient {
  id          Int            @id @default(autoincrement())
  userId      Int
  platform    ClientPlatform
  /// 앱 버전 (ios, android). web 은 null
  appVersion  String?        @db.VarChar(32)
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([lastSeenAt])
}

/// (#539) 앱 업데이트 안내의 기종 (D-292)
enum AppPlatform {
  ios
  android
}

/// (#539) 기종별 앱 최신, 최소 버전과 스토어 주소 (D-292). 관리자 "앱 버전" 화면에서 고친다.
/// 행이 없거나 버전이 null 이면 안내하지 않는다. 스토어 주소가 null 이면 코드의 기본 주소
model AppRelease {
  id            Int         @id @default(autoincrement())
  platform      AppPlatform @unique
  /// 이보다 낮으면 "새 버전이 나왔어요" (버전마다 한 번, 닫을 수 있음)
  latestVersion String?     @db.VarChar(32)
  /// 이보다 낮으면 "업데이트가 필요해요" (닫을 수 없음). latestVersion 보다 높을 수 없다
  minVersion    String?     @db.VarChar(32)
  storeUrl      String?     @db.VarChar(500)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

/// (#188) 알림 종류. 내 정보 > 알림 의 토글과 대응 (WEEKLY 는 변형마다 토글이 따로, D-204)
enum PushKind {
  REMINDER
  CHANGE
  ANNIVERSARY
  JOIN
  /// (#277) 주간 요약과 조용한 팀 깨우기. payload.variant = 'SUMMARY' | 'NUDGE' (D-203)
  WEEKLY
  /// (#189) 약속 투표: 열림(PO:), 정함(PC:), 마감(PD:). 문구는 예약할 때 만든다 (D-241)
  POLL
  /// (#528) 공지 푸시 (N:{noticeId}). 팀이 없는 전체 대상이라 groupId 가 null. 문구는 펼칠 때 공지에서 만든다 (D-287)
  NOTICE
}

/// (#188) PENDING 예약 → DISPATCHED 받을 기기로 펼침 / CANCELLED 묶음으로 취소, (#277) 주간 알림을 보내지 않기로 판정 / SKIPPED 10분(주간은 3시간) 넘게 늦어 버림
enum PushNotificationStatus {
  PENDING
  DISPATCHED
  CANCELLED
  SKIPPED
}

/// (#188) QUEUED → SENDING → SENT(Expo 접수) / FAILED
enum PushDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

/// (#188) 푸시를 받을 기기. 로그아웃하면 지우고, 탈퇴하면 Cascade 로 지운다
model PushDevice {
  id         Int            @id @default(autoincrement())
  userId     Int
  /// Expo 푸시 토큰 'ExponentPushToken[...]'. 한 기기는 한 사용자
  token      String         @unique @db.VarChar(200)
  platform   DevicePlatform
  /// 등록한 앱 버전 (문제 추적용)
  appVersion String         @db.VarChar(20)
  createdAt  DateTime       @default(now())
  /// 웹이 마지막으로 등록을 확인한 시각 (1시간 단위)
  lastSeenAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

/// (#188) 보낼 알림 한 건 (사람, 기기와 무관한 "무엇을 언제"). dedupeKey 로 한 번만 생긴다
model PushNotification {
  id            Int                    @id @default(autoincrement())
  kind          PushKind
  /// 중복 방지 키 (D-89). 같은 키는 다시 만들지 않는다
  dedupeKey     String                 @unique @db.VarChar(120)
  /// (#528) NOTICE(전체 대상)만 null. 그 밖은 늘 팀이 있다
  groupId       Int?
  scheduledAt   DateTime
  status        PushNotificationStatus @default(PENDING)
  /// CHANGE 묶음 키 "{actorId}:{eventId}" (D-90). 그 밖은 null
  coalesceKey   String?                @db.VarChar(40)
  /// CHANGE 에 보일 동작 (묶은 결과). 그 밖은 null
  changeAction  EventLogAction?
  /// 대상. FK 를 걸지 않는다 (원본이 지워져도 기록은 남고, 발송 때 판정)
  eventId       Int?
  occurrence    DateTime?              @db.Date
  eventLogId    Int?
  anniversaryId Int?
  /// CHANGE 의 변경한 사람, JOIN 의 합류한 사람. 받는 사람에서 뺀다
  actorId       Int?
  /// 펼칠 때 만든 문구와 경로 { title, subtitle, body, url, expiration }. 기록과 재현용
  payload       Json?
  dispatchedAt  DateTime?
  createdAt     DateTime               @default(now())

  group      Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]

  @@index([status, scheduledAt])
  @@index([coalesceKey, status])
  @@index([createdAt])
}

/// (#188) 기기 하나에 보낸 기록. (알림, 토큰) 이 유일해 한 기기에 한 번만 간다
model PushDelivery {
  id               Int                @id @default(autoincrement())
  notificationId   Int
  userId           Int
  token            String             @db.VarChar(200)
  platform         DevicePlatform
  status           PushDeliveryStatus @default(QUEUED)
  attempts         Int                @default(0)
  /// Expo 티켓 id (SENT 일 때)
  ticketId         String?            @db.VarChar(64)
  /// Expo 오류 코드 (DeviceNotRegistered 등) 또는 TIMEOUT, EXPIRED
  error            String?            @db.VarChar(64)
  /// 영수증 결과 'ok' | 오류 코드. null 이면 아직 확인 안 함
  receipt          String?            @db.VarChar(64)
  sentAt           DateTime?
  receiptCheckedAt DateTime?
  createdAt        DateTime           @default(now())

  notification PushNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, token])
  @@index([status, createdAt])
  @@index([status, receiptCheckedAt, sentAt])
}

/// (#188) 프로세스 안 예약 작업의 임대와 진행 위치. 행 'push' (D-87), (#277) 행 'weekly' 는 dailyDoneOn 에 주간 알림을 예약한 월요일만 적는다 (임대는 'push' 행, D-203)
model SchedulerLease {
  name        String    @id @db.VarChar(40)
  /// 임대를 가진 프로세스 id (기동 때 랜덤)
  holder      String?   @db.VarChar(40)
  leaseUntil  DateTime
  /// 일정 알림과 기념일 계산을 마친 시각 (창의 아래 끝)
  cursor      DateTime?
  /// 하루 한 번 청소를 마친 KST 날짜
  dailyDoneOn DateTime? @db.Date
  updatedAt   DateTime  @updatedAt
}

/// (#276) 팀 공유 할 일 목록 (장보기, 여행 준비물). 날짜 없음 (설계 할일-목록.md, D-206)
model TodoList {
  id         Int      @id @default(autoincrement())
  groupId    Int
  /// 주소(`/todos/<code>`)에서 번호 대신 쓰는 공개 코드. 소문자 영숫자 8자 (common/public-code.ts, D-197 과 같은 규칙)
  publicCode String   @unique @db.Char(8)
  name       String   @db.VarChar(30)
  /// 만든 사람. 탈퇴하면 null ("탈퇴한 멤버")
  creatorId  Int?
  /// 목록이나 항목을 마지막으로 바꾼 사람 (목록 화면 "민지, 3분 전")
  editorId   Int?
  createdAt  DateTime @default(now())
  /// 항목이 바뀌어도 올린다 (목록 정렬, D-207)
  updatedAt  DateTime @updatedAt

  group   Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User?      @relation("TodoListCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  editor  User?      @relation("TodoListEditor", fields: [editorId], references: [id], onDelete: SetNull)
  items   TodoItem[]

  @@index([groupId, updatedAt])
}

/// (#276) 할 일 항목. 팀은 목록을 거쳐 찾는다 (groupId 없음, D-206)
model TodoItem {
  id        Int       @id @default(autoincrement())
  listId    Int
  text      String    @db.VarChar(100)
  done      Boolean   @default(false)
  /// 완료한 시각. done=false 면 null (D-207)
  doneAt    DateTime?
  /// 완료한 사람. done=false 거나 탈퇴하면 null
  doneById  Int?
  creatorId Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  list    TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)
  doneBy  User?    @relation("TodoItemDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  creator User?    @relation("TodoItemCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([listId, done, createdAt])
}

/// (#193) 외부 캘린더 구독 주소 (ICS 피드, 설계 캘린더-내보내기.md, D-217). (사용자, 팀) 하나에 하나.
/// 토큰 자체는 저장하지 않는다: 토큰 = base64url(HMAC-SHA256(HKDF(JWT_SECRET, "wwm-ics-feed"), "<userId>:<groupId>:<tokenSalt>")) 43자.
/// 조회는 tokenHash 로, 주소를 다시 보여 줄 때는 서버가 소금으로 다시 만든다. 재발급 = 소금 교체. 나가기는 행 삭제, 탈퇴, 팀 삭제는 Cascade
model CalendarFeed {
  id                   Int       @id @default(autoincrement())
  userId               Int
  groupId              Int
  /// 16바이트 랜덤 base64url 22자. 이것만으로는 토큰을 만들 수 없다 (서버 비밀 필요)
  tokenSalt            String    @db.Char(22)
  /// sha256(토큰) hex. 공개 피드가 이 값으로 행을 찾는다
  tokenHash            String    @unique @db.Char(64)
  includeMemo          Boolean   @default(false)
  includeAnniversaries Boolean   @default(true)
  /// 외부 캘린더가 마지막으로 가져간 시각. 1분 단위로만 갱신
  lastFetchedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

/// (#189) 약속 투표 상태. 마감(expired)은 읽을 때 deadline 으로 계산한다 (D-235)
enum PollStatus {
  OPEN
  CLOSED
}

/// (#189) 약속 투표 (설계 약속-투표.md, D-234 ~ D-241). 빈 시간 결과에서 고른 후보 2~5개 중 하나를 정하면 그대로 일정이 된다
model Poll {
  id                 Int        @id @default(autoincrement())
  groupId            Int
  /// 주소(`/polls/<code>`)에서 번호 대신 쓰는 공개 코드 (common/public-code.ts, #311 과 같은 규칙)
  publicCode         String     @unique @db.Char(8)
  /// 정하면 일정 제목이 된다
  title              String     @db.VarChar(50)
  status             PollStatus @default(OPEN)
  /// 마감. 지나면 표를 받지 않고 만든 사람에게 푸시 1건. 정하기는 그 뒤에도 된다. null 이면 마감 없음
  deadline           DateTime?
  /// true 면 "모두"(그 팀 멤버 전원, 동적). false 면 participants 행 (일정 참여자 D-130 과 같은 규칙)
  /// (#444) 일정과 같이 "모두" 는 더 저장하지 않고 기본값 false (D-263)
  allMembers         Boolean    @default(false)
  /// 연 사람. 탈퇴하면 null ("탈퇴한 멤버")
  creatorId          Int?
  /// 정해서 생긴 일정. 일정이 지워지면 null
  eventId            Int?       @unique
  /// 정한 후보 (FK 없음. 후보는 투표와 함께만 지워진다)
  decidedOptionId    Int?
  /// 마감 푸시를 예약한 시각. 틱이 한 번만 집게 한다
  deadlineNotifiedAt DateTime?
  createdAt          DateTime   @default(now())
  closedAt           DateTime?

  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator      User?             @relation("PollCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  event        Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  options      PollOption[]
  participants PollParticipant[]

  @@index([groupId, status])
  @@index([status, deadline])
}

/// (#189) 후보 시간. 시간 후보이거나 종일 후보(KST 00:00 ~ 다음 날 00:00 단위)
model PollOption {
  id       Int      @id @default(autoincrement())
  pollId   Int
  startsAt DateTime
  endsAt   DateTime
  allDay   Boolean  @default(false)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@unique([pollId, startsAt, endsAt])
}

/// (#189) "가능" 표. 행이 있으면 가능. 나가면 그 팀 투표의 내 표를 지우고 탈퇴는 Cascade
model PollVote {
  optionId  Int
  userId    Int
  createdAt DateTime @default(now())

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
  @@index([userId])
}

/// (#189) allMembers = false 일 때 투표 대상. 나가면 행 삭제
model PollParticipant {
  pollId Int
  userId Int

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([userId])
}
