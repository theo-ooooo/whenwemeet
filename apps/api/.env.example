# apps/api/.env — NestJS 백엔드. `cp apps/api/.env.example apps/api/.env` 후 값 채움
# 변수 정의: docs/설계/api.md "환경 변수", docs/설계/인증흐름.md

# ── 서버 ──────────────────────────────────────────────
# API 가 듣는 포트 (기본 4000)
PORT=4000
# CORS 허용 origin 이자 로그인 후 리다이렉트할 웹 주소 (운영은 https://whenwemeet.day 같은 실제 도메인)
WEB_ORIGIN=http://localhost:3000
# 브라우저/카카오가 접근하는 API 의 공개 주소. KAKAO_REDIRECT_URI 의 앞부분과 같아야 함
API_PUBLIC_URL=http://localhost:4000

# ── DB (Prisma / MySQL) ───────────────────────────────
# (A) docker compose 사용 시: 루트 .env 의 MYSQL_* 값과 동일해야 함
DATABASE_URL="mysql://wwm:wwmpw@localhost:3307/whenwemeet"
# e2e 테스트 전용 DB. 테스트가 데이터를 지우므로 반드시 별도 DB 로 둘 것 (compose 첫 기동 시 자동 생성)
TEST_DATABASE_URL="mysql://wwm:wwmpw@localhost:3307/whenwemeet_test"
# (B) 로컬 Homebrew MySQL(3306) 사용 시 위 두 줄을 아래처럼 바꾼다 (<비밀번호> 는 본인 환경 값, 없으면 비움)
# DATABASE_URL="mysql://root:<비밀번호>@localhost:3306/whenwemeet"
# TEST_DATABASE_URL="mysql://root:<비밀번호>@localhost:3306/whenwemeet_test"

# ── 자체 JWT (HS256) ─────────────────────────────────
# 32자 이상 랜덤 문자열. 생성 예: `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
# 만료 기간 = 세션 쿠키 Max-Age (30일)
JWT_EXPIRES_IN=30d

# ── 카카오 로그인 (https://developers.kakao.com) ──────
# 내 애플리케이션 > 앱 설정 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=
# 제품 설정 > 카카오 로그인 > 보안 > Client Secret (코드 생성 후 "사용함" 으로 활성화)
KAKAO_CLIENT_SECRET=
# 내 애플리케이션 > 앱 설정 > 앱 키 > Admin 키 (회원 탈퇴 시 unlink 호출에 사용, 절대 외부 노출 금지)
KAKAO_ADMIN_KEY=
# 제품 설정 > 카카오 로그인 > Redirect URI 에 이 값을 그대로 등록. `${API_PUBLIC_URL}/v1/auth/kakao/callback`
KAKAO_REDIRECT_URI=http://localhost:4000/v1/auth/kakao/callback
