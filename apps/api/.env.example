# apps/api/.env — NestJS 백엔드. `cp apps/api/.env.example apps/api/.env` 후 값 채움
# 변수 정의: docs/설계/api.md "환경 변수", docs/설계/인증흐름.md

# ── 서버 ──────────────────────────────────────────────
# API 가 듣는 포트 (기본 4000)
PORT=4000
# CORS 허용 origin 이자 로그인 후 리다이렉트할 웹 주소 (운영은 https://whenwemeet.day 같은 실제 도메인)
WEB_ORIGIN=http://localhost:3000
# 브라우저/카카오가 접근하는 API 의 공개 주소. KAKAO_REDIRECT_URI 의 앞부분과 같아야 함
API_PUBLIC_URL=http://localhost:4000

# ── DB (Prisma / MySQL) ───────────────────────────────
# (A) docker compose 사용 시: 루트 .env 의 MYSQL_* 값과 동일해야 함
DATABASE_URL="mysql://wwm:wwmpw@localhost:3307/whenwemeet"
# e2e 테스트 전용 DB. 테스트가 데이터를 지우므로 반드시 별도 DB 로 둘 것 (compose 첫 기동 시 자동 생성)
TEST_DATABASE_URL="mysql://wwm:wwmpw@localhost:3307/whenwemeet_test"
# (B) 로컬 Homebrew MySQL(3306) 사용 시 위 두 줄을 아래처럼 바꾼다 (<비밀번호> 는 본인 환경 값, 없으면 비움)
# DATABASE_URL="mysql://root:<비밀번호>@localhost:3306/whenwemeet"
# TEST_DATABASE_URL="mysql://root:<비밀번호>@localhost:3306/whenwemeet_test"

# ── 자체 JWT (HS256) ─────────────────────────────────
# 32자 이상 랜덤 문자열. 생성 예: `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
# 만료 기간 = 세션 쿠키 Max-Age (30일)
JWT_EXPIRES_IN=30d

# ── 카카오 로그인 (https://developers.kakao.com) ──────
# 내 애플리케이션 > 앱 설정 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=
# 제품 설정 > 카카오 로그인 > 보안 > Client Secret (코드 생성 후 "사용함" 으로 활성화)
KAKAO_CLIENT_SECRET=
# 내 애플리케이션 > 앱 설정 > 앱 키 > Admin 키 (회원 탈퇴 시 unlink 호출에 사용, 절대 외부 노출 금지)
KAKAO_ADMIN_KEY=
# 제품 설정 > 카카오 로그인 > Redirect URI 에 이 값을 그대로 등록. `${API_PUBLIC_URL}/v1/auth/kakao/callback`
KAKAO_REDIRECT_URI=http://localhost:4000/v1/auth/kakao/callback
# 내 애플리케이션 > 앱 설정 > 앱 키 화면의 앱 ID (숫자, 비밀 아님). 앱(카카오 SDK) 로그인 토큰의 app_id 대조용 (docs/설계/앱.md 3.1)
# 비어 있으면 서버는 뜨고 POST /v1/auth/kakao/native 만 503 KAKAO_NOT_CONFIGURED (D-55)
KAKAO_APP_ID=

# ── Sign in with Apple (https://developer.apple.com/account, docs/설계/앱.md 3.2 ~ 3.5, 12장) ──
# 하나라도 비어 있으면 서버는 뜨고 애플 로그인 엔드포인트만 503 APPLE_NOT_CONFIGURED (D-55)
# Membership 화면의 Team ID (10자)
APPLE_TEAM_ID=
# Keys 에서 만든 Sign in with Apple 키의 Key ID
APPLE_KEY_ID=
# 그 키의 .p8 파일 본문 (-----BEGIN PRIVATE KEY----- 포함, 줄바꿈은 \n 으로 써도 됨). 비밀값. 배포 플랫폼 시크릿에만 둔다
APPLE_PRIVATE_KEY=
# iOS 앱 번들 ID (day.whenwemeet.app). 네이티브 로그인 토큰의 aud
APPLE_BUNDLE_ID=
# Services ID (예 day.whenwemeet.web). 웹과 Android 애플 로그인의 client_id 이자 aud
APPLE_SERVICE_ID=
# Services ID 에 등록한 Return URL 과 같은 값. `${API_PUBLIC_URL}/v1/auth/apple/callback` (https 필수, localhost 불가)
APPLE_REDIRECT_URI=

# ── 프로필 사진 저장소 (Cloudflare R2, docs/운영/cloudflare-r2.md) ──
# 하나라도 비어 있으면 서버는 뜨고 POST /me/avatar 만 503 STORAGE_NOT_CONFIGURED. 가입 시 소셜 사진 복사도 건너뛴다
# R2 개요 화면의 계정 ID. S3 엔드포인트는 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# R2 > Manage R2 API Tokens (Object Read & Write, 버킷 지정)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 개발 whenwemeet-dev, 운영 whenwemeet
R2_BUCKET=
# 공개 주소. 운영 https://images.whenwemeet.app, 개발은 r2.dev 주소 (끝 슬래시 없이)
R2_PUBLIC_BASE_URL=

# (#185) 오류 수집 Sentry (docs/운영/모니터링.md). 비우면 꺼진다. 로컬은 비워 둔다
SENTRY_DSN=
# 선택. 없으면 NODE_ENV
SENTRY_ENVIRONMENT=

# (#199) 장소 검색 프록시. 지도 전용 카카오 앱의 "언제볼까 장소 검색" REST 키 (로그인 키와 다른 앱). 비우면 로컬은 가짜 장소 목록, 운영은 장소 검색만 503
KAKAO_REST_API_KEY=
# 1 이면 키가 있어도 가짜 장소 목록 (로컬에서 쿼터를 쓰지 않게)
PLACE_SEARCH_FAKE=
