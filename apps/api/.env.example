PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Prisma / MySQL (docker-compose 기본값과 동일)
DATABASE_URL="mysql://wwm:wwmpw@localhost:3307/whenwemeet"

# 자체 JWT (32자 이상 랜덤 문자열)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=
# 카카오 로그인 > 보안 > Client Secret (사용함으로 설정 시)
KAKAO_CLIENT_SECRET=
# 카카오 로그인 > Redirect URI 에 등록할 값
KAKAO_REDIRECT_URI=http://localhost:4000/v1/auth/kakao/callback
