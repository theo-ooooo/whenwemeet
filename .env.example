# 루트 .env — docker-compose(MySQL) 전용. `cp .env.example .env` 후 사용
# 아래 값을 바꾸면 apps/api/.env 의 DATABASE_URL / TEST_DATABASE_URL 도 같이 바꿀 것

# MySQL root 비밀번호 (로컬 전용, 컨테이너 안에서만 쓰임)
MYSQL_ROOT_PASSWORD=rootpw
# 앱이 쓰는 DB 이름. 테스트 DB 는 첫 기동 시 `<이름>_test` 로 자동 생성
MYSQL_DATABASE=whenwemeet
# 앱 접속 계정 / 비밀번호
MYSQL_USER=wwm
MYSQL_PASSWORD=wwmpw
# 호스트에 노출할 포트. 로컬 MySQL(3306) 과 겹치지 않도록 3307
MYSQL_PORT=3307
