{
  "name": "whenwemeet",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r --filter ./apps/* build",
    "lint": "pnpm -r --filter ./apps/* lint",
    "knip": "knip",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\" \"apps/api/test/**/*.ts\" \"apps/mobile/*.ts\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx}\" \"apps/api/test/**/*.ts\" \"apps/mobile/*.ts\""
  },
  "pnpm": {
    "patchedDependencies": {
      "expo-modules-jsi@58.0.22": "patches/expo-modules-jsi@58.0.22.patch"
    }
  },
  "devDependencies": {
    "knip": "^5",
    "prettier": "^3.4.2"
  }
}
